generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  STAFF
}

enum PaymentMode {
  UPI
  Card
  Cash
}

enum PaymentStatus {
  PAID
  PENDING
}

// How a gym takes attendance. Matches the enum created by the attendance_modes migration.
enum AttendanceMode {
  QR
  BIOMETRIC
}

model Gym {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique // gym code members type at login
  address            String?
  gstNumber          String?
  gstRatePercent     Int      @default(18)
  monthlyRevenueGoal Int      @default(0)
  upiId              String?
  paymentQrUrl       String?
  bannerUrl          String?
  tagline            String?
  attendanceMode     AttendanceMode @default(QR)
  biometricKeyHash   String?  // SHA-256 of the gym's API key (LAN bridge / REST); plain key is shown once
  clearedPrefilledPlans Boolean? @default(false)
  saasPlan           String   @default("TRIAL_14_DAYS")
  saasStatus         String   @default("ACTIVE") // PENDING_APPROVAL, ACTIVE, TRIAL, EXPIRED, SUSPENDED
  saasExpiresAt      DateTime?
  saasApprovedAt     DateTime?
  isSuspended        Boolean  @default(false)
  subscriptionAmount Int      @default(0)
  createdAt          DateTime @default(now())

  users          User[]
  members        Member[]
  plans          Plan[]
  memberships    Membership[]
  payments       Payment[]
  attendances    Attendance[]
  queries        MemberQuery[]
  reminders      GymReminder[]
  ownerFeedbacks OwnerFeedback[]
  adminMessages  AdminMessage[]
  enrollments    Enrollment[]
  devices        Device[]
  biometricPunches BiometricPunch[]
  biometricLogs  BiometricLog[]
}

model User {
  id         String   @id @default(cuid())
  gymId      String
  authUserId String   @unique @db.Uuid // Supabase Auth user id
  name       String
  email      String   @unique
  phone      String?
  role       Role
  avatarUrl  String?
  createdAt  DateTime @default(now())

  gym Gym @relation(fields: [gymId], references: [id])

  @@index([gymId])
}

model Plan {
  id             String   @id @default(cuid())
  gymId          String
  name           String
  durationMonths Int
  price          Int
  originalPrice  Int?
  features       String[]
  popular        Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  gym         Gym          @relation(fields: [gymId], references: [id])
  memberships Membership[]

  @@index([gymId])
}

model Member {
  id         String   @id @default(cuid())
  gymId      String
  authUserId String?  @unique @db.Uuid // Supabase Auth user id, set when the login is created
  memberCode String
  biometricId Int?    // number the member is enrolled under on the machine (machines only accept digits); unique per gym
  name       String
  phone      String
  email      String?
  dob        DateTime?
  timingSlot String?  @default("MORNING") // MORNING, EVENING, BOTH
  weight     Float?   // in kg
  height     Float?   // in cm
  bmi        Float?   // BMI value
  bmiCategory String? // Underweight, Normal, Overweight, Obese
  photoUrl   String?
  joinedAt   DateTime @default(now())
  createdAt  DateTime @default(now())

  gym         Gym          @relation(fields: [gymId], references: [id])
  memberships Membership[]
  payments    Payment[]
  attendances Attendance[]
  queries     MemberQuery[]
  reminders   GymReminder[]

  @@unique([gymId, memberCode])
  @@unique([gymId, biometricId])
  @@index([gymId])
}

model Membership {
  id        String   @id @default(cuid())
  gymId     String
  memberId  String
  planId    String
  startsAt  DateTime
  expiresAt DateTime
  createdAt DateTime @default(now())

  gym      Gym       @relation(fields: [gymId], references: [id])
  member   Member    @relation(fields: [memberId], references: [id])
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([gymId, expiresAt])
  @@index([memberId])
}

model Payment {
  id           String        @id @default(cuid())
  gymId        String
  memberId     String
  membershipId String?
  amount       Int
  gstAmount    Int
  mode         PaymentMode
  status       PaymentStatus
  invoiceNo    String
  discountAmount Int?        @default(0)
  notes        String?
  createdAt    DateTime      @default(now())

  gym        Gym         @relation(fields: [gymId], references: [id])
  member     Member      @relation(fields: [memberId], references: [id])
  membership Membership? @relation(fields: [membershipId], references: [id])

  @@unique([gymId, invoiceNo])
  @@index([gymId, createdAt])
}

model Attendance {
  id          String   @id @default(cuid())
  gymId       String
  memberId    String
  checkedInAt DateTime @default(now())

  gym    Gym    @relation(fields: [gymId], references: [id])
  member Member @relation(fields: [memberId], references: [id])

  @@index([gymId, checkedInAt])
  @@index([memberId])
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponCode String
  gymSlug    String?
  createdAt  DateTime @default(now())

  @@index([couponCode])
}

model MemberQuery {
  id        String   @id @default(cuid())
  gymId     String
  memberId  String
  category  String   // WORKOUT_PLAN, MACHINE_MALFUNCTION, TIMINGS, BILLING, OTHER
  subject   String
  message   String
  status    String   @default("PENDING") // PENDING, IN_PROGRESS, RESOLVED
  reply     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gym    Gym    @relation(fields: [gymId], references: [id])
  member Member @relation(fields: [memberId], references: [id])

  @@index([gymId])
  @@index([memberId])
}

model GymReminder {
  id        String   @id @default(cuid())
  gymId     String
  memberId  String?  // null = broadcast to all gym members
  title     String
  message   String
  type      String   @default("GENERAL") // EXPIRY, PAYMENT_DUE, ANNOUNCEMENT, GENERAL
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  gym    Gym     @relation(fields: [gymId], references: [id])
  member Member? @relation(fields: [memberId], references: [id])

  @@index([gymId])
  @@index([memberId])
}

model OwnerFeedback {
  id         String   @id @default(cuid())
  gymId      String
  category   String   // FEATURE_REQUEST, BUG_REPORT, BILLING, HARDWARE, OTHER
  subject    String
  message    String
  status     String   @default("OPEN") // OPEN, IN_REVIEW, RESOLVED
  adminReply String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  gym Gym @relation(fields: [gymId], references: [id])

  @@index([gymId])
  @@index([status])
}

model AdminMessage {
  id        String   @id @default(cuid())
  gymId     String?  // null = broadcast to all gyms
  title     String
  message   String
  priority  String   @default("NORMAL") // NORMAL, HIGH, URGENT
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  gym Gym? @relation(fields: [gymId], references: [id])

  @@index([gymId])
  @@index([createdAt])
}

model Enrollment {
  id            String    @id @default(cuid())
  gymId         String
  name          String
  phone         String
  email         String?
  gender        String?
  dob           DateTime?
  planId        String
  planName      String
  timingSlot    String?   @default("MORNING")
  weight        Float?
  height        Float?
  bmi           Float?
  bmiCategory   String?
  amount        Int       @default(0)
  utrNumber     String?
  paymentStatus String    @default("PAID_PENDING_VERIFICATION")
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  gym Gym @relation(fields: [gymId], references: [id])

  @@index([gymId])
  @@index([status])
}

// A physical biometric machine. The serial number (SN) is how the machine introduces itself
// to /iclock/* (ADMS push), so registering the SN under a gym is what authorises the machine.
model Device {
  id           String    @id @default(cuid())
  gymId        String
  serialNumber String    @unique
  name         String
  protocol     String    @default("ADMS") // ADMS (cloud push) or API (LAN bridge / REST)
  isActive     Boolean   @default(true)
  lastSeenAt   DateTime?
  lastIp       String?
  createdAt    DateTime  @default(now())

  gym Gym @relation(fields: [gymId], references: [id])

  @@index([gymId])
}

// Every raw punch we receive. The unique key makes re-sent punches (machines resend until they get "OK") harmless.
model BiometricPunch {
  id           String   @id @default(cuid())
  gymId        String
  deviceSerial String   @default("") // empty for punches that did not come from a registered machine (REST / test)
  pin          String   // the ID exactly as the machine sent it
  memberId     String?
  punchedAt    DateTime
  verifyType   String?  // FINGERPRINT, FACE, CARD, PASSWORD, PALM, OTHER
  verifyCode   Int?
  source       String   @default("ADMS") // ADMS, API, TEST
  result       String   // GRANTED, ALREADY_IN, EXPIRED, UNKNOWN_ID, BAD_TIME, STALE
  createdAt    DateTime @default(now())

  gym Gym @relation(fields: [gymId], references: [id])

  @@unique([gymId, deviceSerial, pin, punchedAt])
  @@index([gymId, punchedAt])
}

// Short activity trail for debugging connections without visiting the gym. Pruned after ~14 days.
model BiometricLog {
  id           String   @id @default(cuid())
  gymId        String?  // null when the machine is not registered to any gym
  deviceSerial String?
  kind         String   // HANDSHAKE, ATTLOG, OPERLOG, UNREGISTERED, API, ERROR
  summary      String
  rawPreview   String?
  createdAt    DateTime @default(now())

  gym Gym? @relation(fields: [gymId], references: [id])

  @@index([gymId, createdAt])
  @@index([deviceSerial, createdAt])
}
